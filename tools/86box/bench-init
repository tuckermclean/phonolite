#!/bin/sh
# PID 1 of the 86Box bench guest (appended to The Monolith's initramfs):
# decode each file in /bench-data, write the results to the raw second
# partition of the disk, where the host reads them.
export PATH=/sbin:/usr/sbin:/bin:/usr/bin
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
REPS=20
for a in $(cat /proc/cmdline); do
    case $a in bench_reps=*) REPS=${a#bench_reps=} ;; esac
done
{
    echo "== cpu"
    grep -E "model name|cpu MHz|bogomips" /proc/cpuinfo
    grep MemTotal /proc/meminfo
    for f in /bench-data/*; do
        echo "== ${f#/bench-data/}"
        /bench "$f" "$REPS"
    done
    echo "== END"
} > /tmp/log 2>&1
cat /tmp/log
# busybox here has no dd; the partition is raw (no filesystem).
cat /tmp/log > /dev/sda2 && sync
while :; do sleep 3600; done
